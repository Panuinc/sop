flowchart TD
    Start([🟢 เริ่ม · ลูกค้าสอบถาม]):::startEnd
    M[M. ข้อมูลตั้งต้น<br/>เปิดข้อมูลลูกค้า / ผู้ขาย / วัสดุ]:::phase

    subgraph P1 ["Phase 1 — รับออเดอร์ + ทำราคา"]
        A1[A1. รับเรื่องจากลูกค้า]
        A2{{"⚑ A2 · ตรวจความครบของข้อมูล<br/>(DOR · ครบหรือยัง?)"}}:::ctrl
        A3to6[A3-A6. สำรวจหน้างาน + ทำ BOM เบื้องต้น<br/>+ ขอราคาวัสดุ + ทำใบเสนอราคา]
        A7{{"⚑ A7 · ทบทวนกำไร (Margin)<br/>อนุมัติราคา"}}:::ctrl
        A8[A8. ส่งใบเสนอราคา + ติดตามผล]
        WonGate{ลูกค้าตอบรับ?}
    end

    subgraph P2 ["Phase 2 — เขียนแบบ + รับ SO"]
        B1to2[B1-B2. รับงาน + เขียนแบบ Shop Drawing]
        B3{{"⚑ B3 · ทบทวนแบบภายใน<br/>(ทำได้จริงหรือไม่?)"}}:::ctrl
        B4to6[B4-B6. ส่งให้ลูกค้า + แก้แบบ]
        B7[/"📋 B7 · แบบอนุมัติฉบับสุดท้าย<br/>(AFC · Approved for Construction)"/]:::artifact
        B8to10[B8-B10. รับ PO + ตรวจสาม-ทาง + เปิด SO]
        B11[B11. ออกใบเรียกเก็บมัดจำ]
        B12{{"⛔ B12 · ด่านยืนยันมัดจำเข้า<br/>ก่อนปล่อยเข้าผลิต"}}:::gate
    end

    subgraph P3 ["Phase 3 — วางแผน + จัดซื้อ + ตรวจรับวัสดุ"]
        C1to3[C1-C3. รับ SO + ทำ BOM + ตรวจสต็อก]
        C4{{"⚑ C4 · ยืนยันวันส่ง<br/>กับลูกค้า"}}:::ctrl
        C5to9[C5-C9. วางแผนผลิต MPS<br/>+ เปิด PR/PO + ติดตามวัสดุ]
        C10{{"⚑ C10 · ออกใบสั่งผลิต<br/>+ จัดชุดเอกสารงาน"}}:::ctrl
        I1[I1. รับวัสดุจากผู้ขาย]
        I2{{"⚑ I2 · ตรวจรับวัสดุ IQC<br/>ผ่านหรือไม่?"}}:::ctrl
        I3[I3. จัดเก็บเข้าคลัง]
        I4[I4. เคลมผู้ขาย]
    end

    subgraph P4 ["Phase 4 — ผลิต"]
        D1to2[D1-D2. รับชุดเอกสารงาน + เบิกวัสดุ]
        D3{{"⚑ D3 · ตั้งเครื่อง<br/>+ ตรวจชิ้นแรก"}}:::ctrl
        D4to10[D4-D10. ตัด/พับ/เจาะ/เชื่อม<br/>/ขัด/พ่นสี/ประกอบ<br/>+ ตรวจคุณภาพระหว่างผลิต]
        D11{{"⚑ D11 · บันทึกของเสีย<br/>(NCR)"}}:::ctrl
        D12to14[D12-D14. บันทึกผลต่าง + แก้แบบกลางทาง<br/>+ ควบคุมงานจ้างเหมา]
        D15[D15. ส่งงานไปตรวจขั้นสุดท้าย]
    end

    subgraph P5 ["Phase 5 — ตรวจคุณภาพ + แพ็ค + ส่งมอบ"]
        E1{{"⚑ E1 · ตรวจคุณภาพขั้นสุดท้าย 100%<br/>เทียบกับแบบ AFC"}}:::ctrl
        E2to5[E2-E5. แก้ของเสีย + แพ็ค<br/>+ ย้ายเข้าคลังสินค้าสำเร็จรูป]
        F1to2[F1-F2. แจ้งพร้อมส่ง<br/>+ ออกใบเรียกเก็บงวดก่อนส่ง]
        F3{{"⛔ F3 · ด่านยืนยันเงินครบ<br/>ก่อนปล่อยของ"}}:::gate
        F4to9[F4-F9. วางเส้นทางขนส่ง<br/>+ ออกใบส่งของและใบกำกับภาษี<br/>+ ส่งสินค้า + ลูกค้าเซ็นรับ]
        F10{{"⚑ F10 · เดินตรวจหน้างาน + ส่งมอบ<br/>ลูกค้าเซ็น PAC/FAC"}}:::ctrl
    end

    subgraph P6 ["Phase 6 — เคลม + เก็บเงิน"]
        G1to8[G1-G8. รับเคลม + วิเคราะห์ต้นเหตุ<br/>+ แก้และป้องกัน + ปิดเคลม]
        H1to4[H1-H4. ออกใบกำกับภาษี + วางบิล<br/>+ รับชำระ + ติดตามหนี้ค้าง]
        H5{{"⚑ H5 · ระงับลูกค้า<br/>ค้างชำระเกิน 60 วัน"}}:::ctrl
    end

    EndNode([🏁 ปิดงาน + เริ่มนับประกัน]):::startEnd

    Start --> M --> A1 --> A2
    A2 -- ไม่ครบ --> A1
    A2 -- ครบ --> A3to6 --> A7 --> A8 --> WonGate
    WonGate -- ไม่ได้งาน --> Lost([❌ ไม่ได้งาน · บันทึกเหตุผล]):::startEnd
    WonGate -- ได้งาน --> B1to2 --> B3 --> B4to6 --> B7 --> B8to10 --> B11 --> B12
    B12 -- ยังไม่เข้า --> Hold1([🛑 พัก SO ไว้]):::startEnd
    B12 -- เข้าแล้ว --> C1to3 --> C4 --> C5to9 --> C10 --> I1 --> I2
    I2 -- ไม่ผ่าน --> I4
    I4 -.-> I1
    I2 -- ผ่าน --> I3 --> D1to2 --> D3 --> D4to10 --> D11
    D11 --> D12to14 --> D15 --> E1
    E1 -- ไม่ผ่าน --> D11
    E1 -- ผ่าน --> E2to5 --> F1to2 --> F3
    F3 -- ยังไม่ครบ --> Hold2([🛑 พักการส่งของ]):::startEnd
    F3 -- ครบแล้ว --> F4to9 --> F10 --> H1to4 --> H5 --> EndNode

    F10 -. มีเคลม .-> G1to8
    G1to8 -. วงจรปรับปรุง CAPA .-> D11

